# --- PostgreSQL (Prisma) ---
# Local: create DB then point URL here. Neon: copy connection string from dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/djn_store?schema=public"

# --- App (Next.js) ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Clerk (https://dashboard.clerk.com → API Keys) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
CLERK_SECRET_KEY="sk_test_REPLACE_ME"
# Webhooks (optional; set when using Clerk webhooks)
# CLERK_WEBHOOK_SECRET="whsec_REPLACE_ME"

# Hosted sign-in/up URLs (adjust if you use custom routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# --- Optional integrations (uncomment when needed) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
